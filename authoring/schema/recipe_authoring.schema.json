{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anime Kitchen Recipe Authoring v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authoringVersion",
    "id",
    "contentVersion",
    "status",
    "inspirationTitle",
    "prepMinutes",
    "cookMinutes",
    "servings",
    "difficulty",
    "contentOrigin",
    "imageAssetId",
    "ingredients",
    "steps",
    "locales"
  ],
  "properties": {
    "authoringVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "contentVersion": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "published", "archived"]},
    "inspirationTitle": {"type": "string", "minLength": 1},
    "prepMinutes": {"type": "integer", "minimum": 0},
    "cookMinutes": {"type": "integer", "minimum": 0},
    "servings": {"type": "integer", "minimum": 1},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "contentOrigin": {"enum": ["original", "inspired", "adapted"]},
    "sourceNote": {"type": ["string", "null"]},
    "imageAssetId": {"type": ["string", "null"]},
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "quantity", "unit"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "quantity": {"type": ["number", "null"]},
          "unit": {"type": ["string", "null"]}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "timerSeconds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "timerSeconds": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "locales": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "ingredients", "steps"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "ingredients": {"type": "object"},
          "steps": {"type": "object"}
        }
      }
    }
  }
}
